// schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================
 * Enums
 * =========================
 */

// Client's Role
enum Role {
  USER
  LAWYER
}

enum VerificationType {
  IDENTITY // government issued ID cards etc.
  BAR_LICENSE // bar council license
  EMAIL
  PHONE
  EDUCATION //educational qualification verification
}

// For Lawyer/User Verification status
enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

// for case status
enum CaseStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
  IN_PROGRESS
  UNDER_REVIEW
}

// Don't know it's purpose
enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

// for case urgency status
enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// don't know what for
enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// For chat communication
enum MessageRole {
  USER
  LAWYER
}

//for lawyer profile settings
enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

// For blog posts
enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/**
 * ================
 * Core Accounts
 * ===============
 */

// A single 'user' model with a 'role' field whose 'enums' are defined above

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phoneNo       String
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  image         String?
  emailVerified Boolean  @default(false)

  // Right now, if User role == USER, then he will only see above fields in his Profile, but if User role == LAWYER, then below fields will apply including LawyerProfile sub-fields

  // Profile and expertise. Right now commente out, make it slowly by seeing dummySchema.txt and deciding what to bring 
  // and what not to bring.
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * profile        LawyerProfile?
   * verifications  Verification[]
   * certifications Certifications[]
   * educations     Education[]
   * experiences    WorkExperience[]
   * skills         UserSkill[]
   * practiceAreas  UserPracticeArea[]
   * // Networking
   * connectionsInitiated Connection[] @relation("connections_initiated")
   * connectionsReceived Connection[] @relation("connections_received")
   * // Cases
   */
  postedCases   Case[]
  /**
   * applications CaseApplication[]
   * assignments  CaseAssignment[]
   * //Content
   * blogPosts BlogPost[]
   * comments  Comment[]
   * likes     PostLike[]
   * //AI /Documents
   * chatSessions ChatSession[]
   * documents    Document[]
   */
  lawyerProfile LawyerProfile?
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model LawyerProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  title                 String?
  bio                   String?
  location              String?
  barNumber             String?
  barCouncil            String?
  yearsOfExperience     Int?     @default(0)
  caseCount             Int?     @default(0)
  hourlyRate            Int?
  isAvailableForProBono Boolean  @default(true)
  website               String?
  linkedinUrl           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id])

  // Basically, we index the aforementioned columns, so when our db query searches, it can search on this indexed field, which improves our query performance.

  @@index([yearsOfExperience])
  @@index([isAvailableForProBono])
}

model Case {
  id             String     @id @default(cuid())
  title          String
  description    String
  postedByUser   String // This is a Foreign Key.
  postedBy       User       @relation(fields: [postedByUser], references: [id]) // This is a Prisma navigation field, this uses
  // 'postedByUser' to locate the actual User who posted the Case.
  status         CaseStatus @default(OPEN)
  urgency        Urgency    @default(MEDIUM)
  location       String
  proBono        Boolean    @default(false) // denotes whether a case is proBono category or not.
  paid           Boolean    @default(true) // denotes whether a case is paid or not.
  remoteAllowed  Boolean    @default(true)
  estimatedHours Int?

  // Contact details of user who posted the case.
  contactName  String
  contactPhone String
  contactEmail String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /**
   * /*applications   CaseApplication[]
   * assignments    CaseAssignment[]
   * practiceAreas  CasePracticeArea[]
   * requiredSkills CaseRequiredSkill[]
   */

  @@index([status])
  @@index([urgency])
  @@index([createdAt])
}

/**
 * ==================
 * Expertise: Practice Areas & Skills
 * =================
 */

// Specifically for Lawyers, they can select their practice areas during profile setup. Check if you can do practiceArea? to this field in 'User' model.
/**
 * model PracticeArea {
 * id   Int    @id @default(autoincrement())
 * name String @unique
 * slug String @unique
 * users UserPracticeArea[]
 * cases CasePracticeArea[]
 * }
 */

//Below  Session Model & Account model are Required/Expected by Better-Auth for working properly.

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                   String    @id @default(cuid())
  userId               String
  accountId            String
  providerId           String
  accessToken          String?   @db.Text
  idToken              String?   @db.Text
  refreshToken         String?   @db.Text
  accessTokenExpiresAt DateTime?
  password             String?
  createdAt            DateTime  @default(now())
  updateAt             DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}
