// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_DEVELOPMENT")
}

/**
 * =========================
 * Enums
 * =========================
 */

// Client's Role
enum Role {
  USER
  LAWYER
}

enum VerificationType {
  IDENTITY // government issued ID cards etc.
  BAR_LICENSE // bar council license
  EMAIL
  PHONE
  EDUCATION //educational qualification verification
}

// For Lawyer/User Verification status
enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

// for case status
enum CaseStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
  IN_PROGRESS
  UNDER_REVIEW
}

// Don't know it's purpose
enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

// for case urgency status
enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// don't know what for
enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// For chat communication
enum MessageRole {
  USER
  LAWYER
}

//for lawyer profile settings
enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

// For blog posts
enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/**
 * ================
 * Core Accounts
 * ===============
 */

// A single 'user' model with a 'role' field whose 'enums' are defined above

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  imageUrl  String?

  // Right now, if User role == USER, then he will only see above fields in his Profile, but if User role == LAWYER, then below fields will apply including LawyerProfile sub-fields

  // Profile and expertise
  profile       LawyerProfile?
  verifications Verification[]
  // certifications Certifications[]
  educations    Education[]
  experiences   WorkExperience[]
  skills        UserSkill[]
  practiceAreas UserPracticeArea[]

  // Networking
  connectionsInitiated Connection[] @relation("connections_initiated")

  connectionsReceived Connection[] @relation("connections_received")

  // Cases

  postedCases  Case[]            @relation("PostedCases")
  applications CaseApplication[]
  assignments  CaseAssignment[]

  //Content

  blogPosts BlogPost[]
  comments  Comment[]
  likes     PostLike[]

  //AI /Documents

  chatSessions ChatSession[]
  documents    Document[]
}

model LawyerProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  title                 String?
  bio                   String?
  location              String?
  barNumber             String?
  barCouncil            String?
  yearsOfExperience     Int?     @default(0)
  caseCount             Int?     @default(0)
  hourlyRate            Int?
  isAvailableForProBono Boolean  @default(true)
  website               String?
  linkedinUrl           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id])

  // Basically, we index the aforementioned columns, so when our db query searches, it can search on this indexed field, which improves our query performance.

  @@index([yearsOfExperience])
  @@index([isAvailableForProBono])
}

/**
 * ==================
 * Expertise: Practice Areas & Skills
 * =================
 */

// Specifically for Lawyers, they can select their practice areas during profile setup. Check if you can do practiceArea? to this field in 'User' model.
model PracticeArea {
  id   Int    @id @default(autoincrement())
  name String @unique
  slug String @unique

  users UserPracticeArea[]
  cases CasePracticeArea[]
}
